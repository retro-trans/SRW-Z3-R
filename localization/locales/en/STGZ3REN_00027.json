    "rengoku:STGZ3REN_00027:00023": {
      "text": "　\n　\n　~Inside Sidereal Base~",
      "status": "draft",
      "source_sha": "8a8918b378",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": [
        "Location banner (pid_MUZIN); same treatment as 00003."
      ]
    },
    "rengoku:STGZ3REN_00027:00024": {
      "text": "$$セツコ$$\n「......」",
      "status": "draft",
      "source_sha": "9314bd01f2",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": [
        "Source has a 5x「…」 long-pause ellipsis; rendered as a single extended '......' per style rule (no literal … characters)."
      ]
    },
    "rengoku:STGZ3REN_00027:00025": {
      "text": "$$ブルー$$\n「What's wrong, $$セツコ$$?\n　Something on your mind...?」",
      "status": "draft",
      "source_sha": "2df54aded7",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00026": {
      "text": "$$セツコ$$\n「No...」",
      "status": "draft",
      "source_sha": "7aa0169876",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00027": {
      "text": "$$ブルー$$\n「It'll be fine.\n　With the Captain, $$ランド$$, and $$クロウ$$,\n　there's nothing to fear, whatever comes」",
      "status": "draft",
      "source_sha": "d134e1e3da",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00028": {
      "text": "$$セツコ$$\n「You're right...」",
      "status": "draft",
      "source_sha": "33572be3cb",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00029": {
      "text": "$$セツコ$$\n（What is this... this uneasy feeling...）",
      "status": "draft",
      "source_sha": "24f45c7101",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00030": {
      "text": "$$ブルー$$\n「Who's there!?」",
      "status": "draft",
      "source_sha": "95da4c7d35",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00031": {
      "text": "???\n「Ah...」",
      "status": "draft",
      "source_sha": "fd410ff57a",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00032": {
      "text": "$$ブルー$$\n「Who are you?\n　A $$サイデリアル$$ soldier?」",
      "status": "draft",
      "source_sha": "7f4654971b",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00033": {
      "text": "???\n「I...」",
      "status": "draft",
      "source_sha": "94e3b6bef7",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00034": {
      "text": "???\n「I don't know what I am...」",
      "status": "draft",
      "source_sha": "a07b16dab4",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00035": {
      "text": "$$セツコ$$\n「Huh...」",
      "status": "draft",
      "source_sha": "86f5034ed2",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
      "notes": []
    },
    "rengoku:STGZ3REN_00027:00036": {
      "text": "???\n「......」",
      "status": "draft",
      "source_sha": "26604fbff1",
      "source_member_sha256": "0d10e4e5d984d26c2a36284535bbbbebbae80efb3ee01947a48abf85fea3d68b",
